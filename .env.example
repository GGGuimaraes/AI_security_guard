# Copy to .env and fill in. NEVER commit .env.
# You can fill it in stage by stage: capture only uses TAPO_*, the AI only OPENROUTER_API_KEY,
# notification only TELEGRAM_*. Each stage complains only about what it is missing.

# Camera account created in the Tapo app: Camera > Settings > Advanced Settings > Camera Account
TAPO_USERNAME=
TAPO_PASSWORD=

# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Create the bot with @BotFather. For the chat_id: send the bot a message and open
# https://api.telegram.org/bot<TOKEN>/getUpdates  → message.chat.id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
